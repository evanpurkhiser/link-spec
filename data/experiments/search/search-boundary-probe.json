    {"id":"length-fifteen","description":"Odd declared byte length one byte short","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"number":15},{"string":"FIXTURE"},{"number":0}],"render":false,"fresh_connection":true,"expect":{"outcome":"any"}},
    {"id":"length-sixteen","description":"Exact declared byte length","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"number":16},{"string":"FIXTURE"},{"number":0}],"render":false,"fresh_connection":true,"expect":{"outcome":"any"}},
    {"id":"length-seventeen","description":"Odd declared byte length one byte long","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"number":17},{"string":"FIXTURE"},{"number":0}],"render":false,"fresh_connection":true,"expect":{"outcome":"any"}},
    {"id":"length-eighteen","description":"Declared byte length one code unit long","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"number":18},{"string":"FIXTURE"},{"number":0}],"render":false,"fresh_connection":true,"expect":{"outcome":"any"}},
    {"id":"length-256","description":"Oversized but bounded declared byte length","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"number":256},{"string":"FIXTURE"},{"number":0}],"render":false,"fresh_connection":true,"expect":{"outcome":"any"}},
    {"id":"search-overlap-pages","description":"Overlapping Search render windows preserve repeated rows","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"FIXTURE"},{"string":"FIXTURE"},{"number":0}],"render_pages":[{"offset":0,"count":4},{"offset":3,"count":4}],"expect":{"outcome":"any"}},
    {"id":"search-zero-page","description":"Zero-count Search render request","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"FIXTURE"},{"string":"FIXTURE"},{"number":0}],"render_pages":[{"offset":0,"count":0}],"expect":{"outcome":"any"}},
