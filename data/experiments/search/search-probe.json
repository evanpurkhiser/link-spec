{
  "name": "search-probe",
  "fixture_profile": "full",
  "fixture_version": 1,
  "defaults": {
    "device": 1,
    "context": "0x01010301",
    "sort": 0,
    "root_capabilities": "0x05cfffff",
    "setup": "extended",
    "page_size": 64,
    "render_arguments": [0, "$total", 12, 1, 0]
  },
  "cases": [
    {"id":"empty","description":"Empty search string","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":""},{"string":""},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"fixture-upper","description":"Uppercase shared token","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"FIXTURE"},{"string":"FIXTURE"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"fixture-lower","description":"Lowercase shared token","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"fixture"},{"string":"fixture"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"fixture-mixed","description":"Mixed-case shared token","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"FiXtUrE"},{"string":"FiXtUrE"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"alpha","description":"Artist and shared content token","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"ALPHA"},{"string":"ALPHA"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"alpha-one","description":"Two-token title query","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"ALPHA ONE"},{"string":"ALPHA ONE"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"one-alpha","description":"Reversed two-token title query","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"ONE ALPHA"},{"string":"ONE ALPHA"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"alpha-double-space-one","description":"Repeated delimiter between tokens","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"ALPHA  ONE"},{"string":"ALPHA  ONE"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"beta","description":"Second artist and shared content token","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"BETA"},{"string":"BETA"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"album","description":"Album entity domain","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"ALBUM"},{"string":"ALBUM"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"album-one","description":"Specific album entity","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"ALBUM ONE"},{"string":"ALBUM ONE"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"remixer","description":"Referenced remixer artist entity","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"REMIXER"},{"string":"REMIXER"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"original","description":"Referenced original-artist entity","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"ORIGINAL"},{"string":"ORIGINAL"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"filename","description":"Long file-name match","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"FIXTURE-01"},{"string":"FIXTURE-01"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"short-filename","description":"DOS short file-name match","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"FIXTU~1"},{"string":"FIXTU~1"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"comment","description":"Comment domain negative control","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"COMMENT-1"},{"string":"COMMENT-1"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"omega-ascii","description":"ASCII spelling does not equal omega symbol","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"OMEGA"},{"string":"OMEGA"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"omega-symbol","description":"Unicode omega token","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"Ω"},{"string":"Ω"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"unicode-omega","description":"Mixed ASCII and Unicode title tokens","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"UNICODE Ω"},{"string":"UNICODE Ω"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"missing","description":"No matching domain","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"NO-SUCH-VALUE"},{"string":"NO-SUCH-VALUE"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"fixture-sort-alphabet","description":"Shared token with Alphabet sort","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":1},{"utf16_bytes":"FIXTURE"},{"string":"FIXTURE"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"fixture-sort-track-number","description":"Shared token with Track Number sort","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":3},{"utf16_bytes":"FIXTURE"},{"string":"FIXTURE"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"fixture-sort-date-added","description":"Shared token with Date Added sort","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":17},{"utf16_bytes":"FIXTURE"},{"string":"FIXTURE"},{"number":0}],"expect":{"outcome":"any"}},
    {"id":"trailing-one","description":"Nonzero trailing request field","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"FIXTURE"},{"string":"FIXTURE"},{"number":1}],"expect":{"outcome":"any"}},
    {"id":"length-zero","description":"Zero declared byte length with nonempty string","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"number":0},{"string":"FIXTURE"},{"number":0}],"render":false,"fresh_connection":true,"expect":{"outcome":"any"}},
    {"id":"length-two","description":"Terminator-only declared byte length with nonempty string","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"number":2},{"string":"FIXTURE"},{"number":0}],"render":false,"fresh_connection":true,"expect":{"outcome":"any"}},
    {"id":"length-short","description":"Declared byte length one code unit short","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"number":14},{"string":"FIXTURE"},{"number":0}],"render":false,"fresh_connection":true,"expect":{"outcome":"any"}},
    {"id":"length-long","description":"Declared byte length one code unit long","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"number":18},{"string":"FIXTURE"},{"number":0}],"render":false,"fresh_connection":true,"expect":{"outcome":"any"}}
  ]
}
