{
  "name": "hot-cue-bank-cues-sequence",
  "fixture_profile": "hot-cue-banks",
  "fixture_version": 1,
  "defaults": {
    "device": 1,
    "context": "0x01010301",
    "sort": 0,
    "root_capabilities": "0x05cfffff",
    "setup": "extended",
    "page_size": 32,
    "render_arguments": [0, "$total", 12, 1, 0]
  },
  "cases": [
    {
      "id": "tree-root",
      "description": "Navigate the Hot Cue Bank root before requesting cue data",
      "request_kind": "0x2001",
      "arguments": [
        {"number": "$context"},
        {"number": 0},
        {"number": 1},
        {"number": 0}
      ],
      "expect": {"outcome": "any"}
    },
    {
      "id": "alpha-bank-tracks",
      "description": "Render Alpha Bank membership before requesting cue data",
      "request_kind": "0x2001",
      "arguments": [
        {"number": "$context"},
        {"number": "$fixture.hotcue.bank.alpha"},
        {"number": 0},
        {"number": 16}
      ],
      "expect": {"outcome": "any"}
    },
    {
      "id": "alpha-bank-cues",
      "description": "Request Alpha Bank cue data after rendering its tracks",
      "request_kind": "0x2101",
      "arguments": [{"number": "$context"}, {"number": "$fixture.hotcue.bank.alpha"}],
      "direct_response": true,
      "render": false,
      "expect": {"outcome": "any"}
    }
  ]
}
