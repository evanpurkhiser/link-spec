{
  "name": "category-disable-special-bits",
  "fixture_profile": "settings",
  "fixture_version": 1,
  "fixture_variant": "category-special-bits",
  "defaults": {
    "device": 1,
    "context": "0x01010301",
    "sort": 0,
    "root_capabilities": "0x05cfffff",
    "setup": "extended",
    "page_size": 3,
    "render_arguments": [0, "$total", 12, 1, 0]
  },
  "cases": [
    {
      "id": "root-captured-mask",
      "description": "Matching disable bit 1 remains visible while ordinary disable bit 0 rows are hidden",
      "request_kind": "0x1000",
      "arguments": [{"number": "$context"}, {"number": "$sort"}, {"number": "$root_capabilities"}],
      "expect": {"outcome": "menu", "total": 18, "row_count": 18, "argument_count": 16}
    },
    {
      "id": "root-all-bits",
      "description": "Category disable predicates remain authoritative with every capability bit set",
      "request_kind": "0x1000",
      "arguments": [{"number": "$context"}, {"number": "$sort"}, {"number": "0xffffffff"}],
      "expect": {"outcome": "menu", "total": 18, "row_count": 18, "argument_count": 16}
    }
  ]
}
