{
  "name": "device-capability-cross",
  "fixture_profile": "full",
  "fixture_version": 1,
  "defaults": {
    "device": 1,
    "context": "0x01010301",
    "sort": 0,
    "root_capabilities": "0x05cfffff",
    "setup": "extended",
    "page_size": 3,
    "render_arguments": [0, "$total", 12, 1, 0]
  },
  "cases": [
    {
      "id": "legacy-mask",
      "description": "Root under legacy capability mask 0x00ffffff",
      "request_kind": "0x1000",
      "arguments": [{"number":"$context"},{"number":"$sort"},{"number":"0x00ffffff"}],
      "expect": {"outcome":"menu"}
    },
    {
      "id": "captured-mask",
      "description": "Root under captured capability mask 0x05cfffff",
      "request_kind": "0x1000",
      "arguments": [{"number":"$context"},{"number":"$sort"},{"number":"0x05cfffff"}],
      "expect": {"outcome":"menu"}
    },
    {
      "id": "all-bits-mask",
      "description": "Root under all-bits capability mask",
      "request_kind": "0x1000",
      "arguments": [{"number":"$context"},{"number":"$sort"},{"number":"0xffffffff"}],
      "expect": {"outcome":"menu"}
    },
    {
      "id": "render-5",
      "description": "Track rows rendered with five request arguments",
      "request_kind": "0x1004",
      "arguments": [{"number":"$context"},{"number":"$sort"}],
      "render_arguments": [0, "$total"],
      "expect": {"outcome":"menu","total":8,"row_count":8,"argument_count":16}
    },
    {
      "id": "render-6",
      "description": "Track rows rendered with six request arguments",
      "request_kind": "0x1004",
      "arguments": [{"number":"$context"},{"number":"$sort"}],
      "render_arguments": [0, "$total", 12],
      "expect": {"outcome":"menu","total":8,"row_count":8,"argument_count":16}
    },
    {
      "id": "render-8",
      "description": "Track rows rendered with eight request arguments",
      "request_kind": "0x1004",
      "arguments": [{"number":"$context"},{"number":"$sort"}],
      "render_arguments": [0, "$total", 12, 1, 0],
      "expect": {"outcome":"menu","total":8,"row_count":8,"argument_count":16}
    }
  ]
}
