{
  "name": "song-info-location2-malformed-history-timing--probe-delay-3000ms",
  "fixture_profile": "full",
  "fixture_version": 1,
  "defaults": {
    "device": 11,
    "context": "0x0b010301",
    "sort": 0,
    "root_capabilities": "0x05cfffff",
    "setup": "extended",
    "page_size": 3,
    "render_arguments": [
      0,
      "$total",
      12,
      1,
      0
    ]
  },
  "cases": [
    {
      "id": "first--play-extra-argument",
      "description": "First malformed precursor: Play Song Info with an extra number",
      "request_kind": "0x2102",
