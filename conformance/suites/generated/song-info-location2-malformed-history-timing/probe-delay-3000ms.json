        {
          "number": "$context"
        },
        {
          "number": "$fixture.track.first"
        },
        {
          "number": "0xdeadbeef"
        }
      ],
      "render": false,
      "fresh_connection": true,
      "expect": {
        "outcome": "any"
      }
    },
    {
      "id": "second--delivery-blob-content",
      "description": "Second malformed precursor: Delivery Song Info with blob content ID",
      "request_kind": "0x2602",
      "arguments": [
        {
          "number": "$context"
        },
        {
          "blob_hex": "01020304"
        }
      ],
      "render": false,
      "fresh_connection": true,
      "expect": {
        "outcome": "any"
      }
    },
    {
      "id": "delivery-probe",
      "description": "Matched RX3 location-2 Delivery after both malformed precursors and a 3000 ms pre-connection delay",
      "request_kind": "0x2602",
      "arguments": [
        {
          "number": "0x0b020301"
        },
        {
          "number": "$fixture.track.first"
        }
      ],
      "render": false,
      "fresh_connection": true,
      "delay_before_connection_ms": 3000,
      "expect": {
        "outcome": "any"
      }
    }
  ]
}
