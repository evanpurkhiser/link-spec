      "arguments": [
        {
          "number": "$context"
        },
        {
          "number": 0
        },
        {
          "utf16_bytes": "CEILING"
        },
        {
          "string": "CEILING"
        },
        {
          "number": 0
        }
      ],
      "render": false,
      "expect": {
        "outcome": "menu",
        "total": 1000
      }
    },
    {
      "id": "search-track-total",
      "description": "Search Track broad-query total without rendering",
      "request_kind": "0x1500",
