{
  "name": "full-menu-coverage",
  "fixture_profile": "full",
  "fixture_version": 1,
  "defaults": {
    "device": 1,
    "context": "0x01010301",
    "sort": 0,
    "root_capabilities": "0x05cfffff",
    "setup": "extended",
    "page_size": 3,
    "render_arguments": [0, "$total", 12, 1, 0]
  },
  "cases": [
    {"id":"root","description":"Configured root and capability mask","request_kind":"0x1000","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$root_capabilities"}],"expect":{"outcome":"menu","total":20,"row_count":20,"argument_count":16}},
    {"id":"tracks","description":"All live tracks, excluding deleted fixture","request_kind":"0x1004","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"menu","total":8,"row_count":8,"argument_count":16}},
    {"id":"genres","description":"Referenced genres","request_kind":"0x1001","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"menu","total":2,"row_count":2}},
    {"id":"genre-artists","description":"Artists referenced under Fixture House","request_kind":"0x1101","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.genre.house"}],"expect":{"outcome":"menu","total":3,"row_count":3}},
    {"id":"genre-albums-all-artists","description":"Albums under Fixture House and ALL artists","request_kind":"0x1201","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.genre.house"},{"number":"0xffffffff"}],"expect":{"outcome":"menu"}},
    {"id":"genre-tracks-all","description":"Tracks under Fixture House with wildcard artist and album","request_kind":"0x1301","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.genre.house"},{"number":"0xffffffff"},{"number":"0xffffffff"}],"expect":{"outcome":"menu","total":4,"row_count":4}},
    {"id":"artists","description":"Referenced primary artists only","request_kind":"0x1002","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"menu","total":2,"row_count":2}},
    {"id":"artist-albums","description":"Multiple albums cause an ALL row","request_kind":"0x1102","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.artist.alpha"}],"expect":{"outcome":"menu","total":3,"row_count":3}},
    {"id":"artist-tracks-all-albums","description":"Wildcard album returns every Alpha Artist track","request_kind":"0x1202","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.artist.alpha"},{"number":"0xffffffff"}],"expect":{"outcome":"menu","total":5,"row_count":5}},
    {"id":"albums","description":"Referenced albums including concrete unknown album","request_kind":"0x1003","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"menu"}},
    {"id":"album-tracks","description":"Concrete album track numbers and ordering","request_kind":"0x1103","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.album.one"}],"expect":{"outcome":"menu","total":3,"row_count":3}},
    {"id":"bpm","description":"Rounded and de-duplicated BPM roots","request_kind":"0x1006","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"menu","total":5,"row_count":5}},
    {"id":"bpm-distances","description":"BPM tolerance values zero through six","request_kind":"0x1106","arguments":[{"number":"$context"},{"number":"$sort"},{"number":12000}],"expect":{"outcome":"menu","total":7,"row_count":7}},
    {"id":"bpm-tracks","description":"Exact BPM-range filter","request_kind":"0x1206","arguments":[{"number":"$context"},{"number":"$sort"},{"number":12000},{"number":0}],"expect":{"outcome":"menu"}},
    {"id":"ratings","description":"All rating values zero through five","request_kind":"0x1007","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"menu","total":6,"row_count":6}},
    {"id":"rating-tracks","description":"Rating equality filter","request_kind":"0x1107","arguments":[{"number":"$context"},{"number":"$sort"},{"number":5}],"expect":{"outcome":"menu","total":1,"row_count":1,"item_ids":["$fixture.track.sixth"]}},
    {"id":"decades","description":"Release-year decade grouping and boundaries","request_kind":"0x1008","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"menu","total":4,"row_count":4}},
    {"id":"years","description":"Concrete years plus ALL within the 2020s","request_kind":"0x1108","arguments":[{"number":"$context"},{"number":"$sort"},{"number":2020}],"expect":{"outcome":"menu","total":4,"row_count":4}},
    {"id":"year-tracks-all","description":"ALL year selector within a decade","request_kind":"0x1208","arguments":[{"number":"$context"},{"number":"$sort"},{"number":2020},{"number":"0xffffffff"}],"expect":{"outcome":"menu","total":3,"row_count":3}},
    {"id":"labels","description":"Referenced labels","request_kind":"0x100a","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"menu","total":2,"row_count":2}},
    {"id":"label-artists","description":"Label hierarchy inserts ALL for multiple artists","request_kind":"0x110a","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.label.one"}],"expect":{"outcome":"menu","total":3,"row_count":3}},
    {"id":"label-albums","description":"Label/artist album hierarchy","request_kind":"0x120a","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.label.one"},{"number":"0xffffffff"}],"expect":{"outcome":"menu"}},
    {"id":"label-tracks","description":"Label wildcard artist and album filtering","request_kind":"0x130a","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.label.one"},{"number":"0xffffffff"},{"number":"0xffffffff"}],"expect":{"outcome":"menu","total":4,"row_count":4}},
    {"id":"colors","description":"All eight configured colors are present","request_kind":"0x100d","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"menu","total":8,"row_count":8}},
    {"id":"color-tracks","description":"Color equality filter","request_kind":"0x110d","arguments":[{"number":"$context"},{"number":"$sort"},{"number":8}],"expect":{"outcome":"menu","total":1,"row_count":1,"item_ids":["$fixture.track.eighth"]}},
    {"id":"times","description":"Minute buckets including 179 and excluding 180","request_kind":"0x1010","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"menu","total":5,"row_count":5}},
    {"id":"time-tracks","description":"Duration minute equality range","request_kind":"0x1110","arguments":[{"number":"$context"},{"number":"$sort"},{"number":1}],"expect":{"outcome":"menu","total":2,"row_count":2}},
    {"id":"bitrates","description":"Distinct bitrates including zero","request_kind":"0x1011","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"menu","total":8,"row_count":8}},
    {"id":"bitrate-tracks","description":"Zero bitrate is a real filter bucket","request_kind":"0x1111","arguments":[{"number":"$context"},{"number":"$sort"},{"number":0}],"expect":{"outcome":"menu","total":1,"row_count":1,"item_ids":["$fixture.track.first"]}},
    {"id":"history","description":"Persisted history versus active Link history lifecycle","request_kind":"0x1012","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"any"}},
    {"id":"filenames","description":"File-name primary text with ordinary track shape","request_kind":"0x1013","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"menu","total":8,"row_count":8}},
    {"id":"keys","description":"Normalized musical-key root","request_kind":"0x1014","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"menu"}},
    {"id":"key-distances","description":"Key-distance selector zero through two","request_kind":"0x1114","arguments":[{"number":"$context"},{"number":"$sort"},{"number":1}],"expect":{"outcome":"menu","total":3,"row_count":3}},
    {"id":"key-tracks","description":"Exact normalized key-distance filter","request_kind":"0x1214","arguments":[{"number":"$context"},{"number":"$sort"},{"number":1},{"number":0}],"expect":{"outcome":"menu"}},
    {"id":"matching-forward-reverse","description":"Both recommendation endpoints and ignored LikeRate","request_kind":"0x1017","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.track.first"}],"expect":{"outcome":"menu","total":2,"row_count":2,"item_ids":["$fixture.track.second","$fixture.track.third"]}},
    {"id":"hot-cue-bank","description":"Populated Hot Cue Bank dispatch behavior","request_kind":"0x1018","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"any"}},
    {"id":"search","description":"Mixed entity/content/file-name search and UTF-16 length","request_kind":"0x1300","arguments":[{"number":"$context"},{"number":"$sort"},{"utf16_bytes":"FIXTURE"},{"string":"FIXTURE"},{"number":0}],"expect":{"outcome":"menu"}},
    {"id":"original-artists","description":"Original Artist foreign-key root","request_kind":"0x1302","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"menu","total":1,"row_count":1}},
    {"id":"original-artist-albums","description":"Original Artist album hierarchy","request_kind":"0x1402","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.artist.original"}],"expect":{"outcome":"menu"}},
    {"id":"original-artist-tracks","description":"Original Artist concrete album tracks","request_kind":"0x1502","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.artist.original"},{"number":"$fixture.album.one"}],"expect":{"outcome":"menu","total":3,"row_count":3}},
    {"id":"remixers","description":"Remixer foreign-key root","request_kind":"0x1602","arguments":[{"number":"$context"},{"number":"$sort"}],"expect":{"outcome":"menu","total":1,"row_count":1}},
    {"id":"remixer-albums","description":"Remixer album hierarchy","request_kind":"0x1702","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.artist.remixer"}],"expect":{"outcome":"menu"}},
    {"id":"remixer-tracks","description":"Remixer concrete album tracks","request_kind":"0x1802","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.artist.remixer"},{"number":"$fixture.album.one"}],"expect":{"outcome":"menu","total":3,"row_count":3}},
    {"id":"playlist-root","description":"Folders precede playlists, with playlist rows ordered by Seq","request_kind":"0x1105","arguments":[{"number":"$context"},{"number":"$sort"},{"number":0},{"number":1}],"expect":{"outcome":"menu","total":3,"row_count":3,"item_ids":["$fixture.playlist.folder","$fixture.playlist.cue_analysis","$fixture.playlist.empty"]}},
    {"id":"playlist-folder","description":"Recursive folder child","request_kind":"0x1105","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.playlist.folder"},{"number":1}],"expect":{"outcome":"menu","total":1,"row_count":1,"item_ids":["$fixture.playlist.primary"]}},
    {"id":"playlist-tracks","description":"Membership TrackNo controls default order","request_kind":"0x1105","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.playlist.primary"},{"number":0}],"expect":{"outcome":"menu","total":3,"row_count":3,"item_ids":["$fixture.track.third","$fixture.track.first","$fixture.track.second"]}},
    {"id":"empty-playlist","description":"Valid empty playlist returns zero","request_kind":"0x1105","arguments":[{"number":"$context"},{"number":"$sort"},{"number":"$fixture.playlist.empty"},{"number":0}],"expect":{"outcome":"menu","total":0,"row_count":0}}
  ]
}
