{
  "name": "hidden-selected-secondary",
  "fixture_profile": "settings",
  "fixture_version": 1,
  "fixture_variant": "hidden-selected-comment",
  "defaults": {
    "device": 1,
    "context": "0x01010301",
    "sort": 0,
    "root_capabilities": "0x05cfffff",
    "setup": "extended",
    "page_size": 3,
    "render_arguments": [0, "$total", 7, 1, 0]
  },
  "cases": [
    {
      "id": "sort-menu",
      "description": "The disabled comment row is absent from the visible sort menu",
      "request_kind": "0x1400",
      "arguments": [{"number": "$context"}, {"number": 0}, {"number": 0}],
      "expect": {"outcome": "menu"}
    },
    {
      "id": "track-rows",
      "description": "The independently selected comment column still renders on track rows",
      "request_kind": "0x1004",
      "arguments": [{"number": "$context"}, {"number": "$sort"}],
      "expect": {"outcome": "menu", "total": 8, "row_count": 8, "argument_count": 16}
    }
  ]
}
